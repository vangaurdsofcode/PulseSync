<?xml version="1.0"?>
<ruleset name="PulseSync WordPress Plugin">
    <description>WordPress Coding Standards for PulseSync Connector.</description>
    <file>pulsesync-connector.php</file>
    <file>src</file>
    <file>uninstall.php</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="minimum_supported_wp_version" value="6.4"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
</ruleset>
